# ─── LLM (Google Gemini) ──────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# ─── Web Search (Tavily) ──────────────────────────────────────────────
# Get a free key at https://app.tavily.com (1000 searches/month free)
TAVILY_API_KEY=your-tavily-api-key-here

# ─── Routing (OpenRouteService) ───────────────────────────────────────
# Free tier ~2,000 requests/day — https://openrouteservice.org/dev/
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here

# ─── Map Tiles (CARTO Voyager) ────────────────────────────────────────
# Get a free key at https://carto.com/basemaps/apikey/ to remove the watermark
CARTO_API_KEY=your-carto-api-key-here

# ─── SerpAPI (optional flight & hotel price search) ───────────────────
# https://serpapi.com/ — free tier available
SERPAPI_KEY=your-serpapi-key-here

# ─── LLM Observability & Tracing (LangSmith) ──────────────────────────
# https://smith.langchain.com/ — optional enterprise telemetry
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wayfarer-travel-planner
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─── RAG (Retrieval-Augmented Generation) & Knowledge Base ────────────
# Enables domain intelligence knowledge retrieval & live context chunking
RAG_ENABLED=true
RAG_TOP_K=5

# ─── App ──────────────────────────────────────────────────────────────
# SQLite file used by LangGraph's checkpointer for state persistence.
# Local: checkpoints.sqlite  |  Vercel: leave unset (auto uses /tmp/wayfarer-checkpoints.sqlite)
CHECKPOINT_DB=checkpoints.sqlite

# Stubs are test-only (pytest sets USE_STUBS=true automatically).
# Do not set USE_STUBS when running the server — live APIs are always used.

# Return HTTP immediately and run the graph in the background (faster UX).
# Set to false only for tests.
GRAPH_BACKGROUND=true

# Terminal pipeline logging: INFO (default) or DEBUG (includes GET /plan polls + cache hits).
LOG_LEVEL=INFO

# SerpAPI flight/hotel cache TTL is 1 hour (in-memory, per server process).
